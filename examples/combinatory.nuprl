-- | Combinatory logic and Church encodings.
--
-- The SKI basis is complete for the typed λ-calculus: `S`, `K`, and `I`
-- inhabit the corresponding combinatory types, and `S K K` converts with `I`.
-- This theory formalizes the core combinator algebra (SKI, B, CFlip, W),
-- their typing and conversion identities, and polymorphic Church encodings
-- for natural numbers, booleans, and pairs, along with algebraic laws.
theory Combinatory

comment book "Combinatory logic, SKI basis, and polymorphic Church encodings."

abs I == λx. x
abs K == λx. λy. x
abs S == λf. λg. λx. (f x) (g x)
abs Bcomb == λf. λg. λx. f (g x)
abs CFlip == λf. λx. λy. f y x
abs W == λf. λx. f x x

-- Church numerals (polymorphic iterators).
abs CNat == ⋂A:U{i}. (A → A) → A → A
abs C0 == λs. λz. z
abs C1 == λs. λz. s z
abs C2 == λs. λz. s (s z)
abs C3 == λs. λz. s (s (s z))
abs CSucc == λn. λs. λz. s (n s z)
abs CPlus == λm. λn. λs. λz. m s (n s z)
abs CMult == λm. λn. λs. m (n s)
abs CToInt(n) == n (λx. x + 1) 0

-- Church booleans.
abs CBool == ⋂A:U{i}. A → A → A
abs CTrue == λt. λf. t
abs CFalse == λt. λf. f
abs CIf(b) == b
abs CAnd(p; q) == p q CFalse
abs COr(p; q) == p CTrue q
abs CNot(p) == p CFalse CTrue

-- Church pairs.
abs CPair(x; y) == λf. f x y
abs CFst(p) == p (λx. λy. x)
abs CSnd(p) == p (λx. λy. y)

soft I, K, S, Bcomb, CFlip, W
soft CNat, C0, C1, C2, C3, CSucc, CPlus, CMult, CToInt
soft CBool, CTrue, CFalse, CIf, CAnd, COr, CNot
soft CPair, CFst, CSnd

--------------------------------------------------------------------------------
-- Combinator typing and conversion
--------------------------------------------------------------------------------

theorem i_ty :
  ∀A:U{i}. A → A
proof
  intro A
  intro x
  hyp
qed

theorem k_ty :
  ∀A:U{i}. ∀B:U{i}. A → B → A
proof
  intro A
  intro B
  intro x
  intro y
  hyp 3
qed

theorem s_ty :
  ∀A:U{i}. ∀B:U{i}. ∀C:U{i}.
    (A → B → C) → (A → B) → A → C
proof
  intro A
  intro B
  intro C
  intro f
  intro g
  intro x
  elim 5 with x THENL [
    hyp,
    elim 4 with x THENL [hyp, elim 8 with y THENL [hyp, hyp]]
  ]
qed

theorem b_ty :
  ∀A:U{i}. ∀B:U{i}. ∀C:U{i}. (B → C) → (A → B) → A → C
proof
  intro A
  intro B
  intro C
  intro f
  intro g
  intro x
  elim 5 with x THENL [hyp, elim 4 with y THENL [hyp, hyp]]
qed

theorem w_ty :
  ∀A:U{i}. ∀B:U{i}. (A → A → B) → A → B
proof
  intro A
  intro B
  intro f
  intro x
  elim 3 with x THENL [
    hyp,
    elim 5 with x THENL [hyp, hyp]
  ]
qed

-- `S K K` converts with `I`.
theorem skk :
  ∀A:U{i}. S K K = I ∈ (A → A)
proof
  intro A
  eq THEN auto
qed

theorem ski_k :
  ∀A:U{i}. ∀B:U{i}. ∀x:A. ∀y:B. K x y = x ∈ A
proof
  intro A
  intro B
  intro x
  intro y
  auto
qed

theorem b_red :
  ∀A:U{i}. ∀B:U{i}. ∀C:U{i}. ∀f:(B → C). ∀g:(A → B). ∀x:A.
    Bcomb f g x = f (g x) ∈ C
proof
  intro A
  intro B
  intro C
  intro f
  intro g
  intro x
  reduce
  auto
qed

theorem cflip_red :
  ∀A:U{i}. ∀B:U{i}. ∀C:U{i}. ∀f:(A → B → C). ∀x:B. ∀y:A.
    CFlip f x y = f y x ∈ C
proof
  intro A
  intro B
  intro C
  intro f
  intro x
  intro y
  reduce
  auto
qed

theorem w_red :
  ∀A:U{i}. ∀B:U{i}. ∀f:(A → A → B). ∀x:A.
    W f x = f x x ∈ B
proof
  intro A
  intro B
  intro f
  intro x
  reduce
  auto
qed

--------------------------------------------------------------------------------
-- Church numerals
--------------------------------------------------------------------------------

theorem c0_ty :
  C0 ∈ CNat
proof
  auto
qed

theorem c1_ty :
  C1 ∈ CNat
proof
  auto
qed

theorem c2_ty :
  C2 ∈ CNat
proof
  auto
qed

theorem csucc_c1 :
  CSucc C1 ∈ CNat
proof
  auto
qed

theorem cplus_c1_c2 :
  CPlus C1 C2 ∈ CNat
proof
  auto
qed

-- Exemplary concrete evaluations
theorem csucc_2 :
  CToInt(CSucc C2) = 3 ∈ Int
proof
  eq
qed

theorem cplus_2_3 :
  CToInt(CPlus C2 C3) = 5 ∈ Int
proof
  eq
qed

--------------------------------------------------------------------------------
-- Church booleans
--------------------------------------------------------------------------------

theorem ctrue_ty :
  CTrue ∈ CBool
proof
  auto
qed

theorem cfalse_ty :
  CFalse ∈ CBool
proof
  auto
qed

theorem cif_true_poly :
  ∀A:U{i}. ∀x:A. ∀y:A.
    CIf(CTrue) x y = x ∈ A
proof
  intro A
  intro x
  intro y
  reduce
  auto
qed

theorem cif_false_poly :
  ∀A:U{i}. ∀x:A. ∀y:A.
    CIf(CFalse) x y = y ∈ A
proof
  intro A
  intro x
  intro y
  reduce
  auto
qed

theorem cand_true_l :
  ∀b:CBool. CAnd(CTrue; b) = b ∈ CBool
proof
  intro b
  reduce
  auto
qed

theorem cnot_true :
  CNot(CTrue) = CFalse ∈ CBool
proof
  reduce
  auto
qed

-- Exemplary boolean test
theorem cif_example :
  CIf(CTrue) 7 9 = 7 ∈ Int
proof
  eq
qed

--------------------------------------------------------------------------------
-- Church pairs
--------------------------------------------------------------------------------

theorem cpair_fst_poly :
  ∀A:U{i}. ∀B:U{i}. ∀x:A. ∀y:B.
    CFst(CPair(x; y)) = x ∈ A
proof
  intro A
  intro B
  intro x
  intro y
  reduce
  auto
qed

theorem cpair_snd_poly :
  ∀A:U{i}. ∀B:U{i}. ∀x:A. ∀y:B.
    CSnd(CPair(x; y)) = y ∈ B
proof
  intro A
  intro B
  intro x
  intro y
  reduce
  auto
qed

-- Exemplary Church pair of numerals
theorem cpair_nats :
  CToInt(CFst(CPair(C2; C3))) = 2 ∈ Int
proof
  eq
qed
