-- | Quotient types and the functionality principle, following Constable et al.
-- §2.4 and §10.3.
--
-- `(x,y):A // E` has the members of `A`, but `a = b` holds when `E[a,b]`
-- is inhabited. Formation requires `E` to be an equivalence relation.
-- A function on representatives is well-defined on the quotient if and only
-- if it respects `E` (the functionality principle `quot_functionality`).
theory Quotients

comment book "Constable et al. §2.4 & §10.3: quotient types, functionality, and equivalence relations."

-- Integers modulo 2: the book's `N2`.
abs EqMod2(x; y) == (x % 2) = (y % 2) ∈ Int
abs Z2 == (x, y):Int // EqMod2(x; y)

-- `max(a,b)` as a program on representatives (the book's counterexample).
abs Max(a; b) == less a b b a

soft EqMod2, Z2, Max

--------------------------------------------------------------------------------
-- The relation is an equivalence
--------------------------------------------------------------------------------

theorem eqmod2_refl :
  ∀x:Int. EqMod2(x; x)
proof
  intro x
  eq
qed

theorem eqmod2_sym :
  ∀x:Int. ∀y:Int. EqMod2(x; y) → EqMod2(y; x)
proof
  intro x
  intro y
  intro p
  elim 3
  eq
qed

theorem eqmod2_trans :
  ∀x:Int. ∀y:Int. ∀z:Int. EqMod2(x; y) → EqMod2(y; z) → EqMod2(x; z)
proof
  intro x
  intro y
  intro z
  intro p
  intro q
  elim 4
  hyp
qed

--------------------------------------------------------------------------------
-- Formation: Z2 is a type
--------------------------------------------------------------------------------

theorem z2_type :
  Z2 ∈ U{i}
proof
  eq THENL [
    eq,
    eq THEN auto,
    eq,
    elim 3 THEN eq,
    elim 4 THEN hyp
  ]
qed

--------------------------------------------------------------------------------
-- Representatives and quotient equality
--------------------------------------------------------------------------------

-- Every integer represents an element of Z2.
theorem int_to_z2 :
  ∀n:Int. n ∈ Z2
proof
  intro n
  eq THENL [hyp, hyp, lemma eqmod2_refl [n] THEN hyp]
qed

-- 0 and 2 are distinct in Int but equal in Z2.
theorem zero_eq_two :
  0 = 2 ∈ Z2
proof
  eq THEN auto
qed

-- 0 and 1 remain distinct in Z2.
theorem zero_ne_one :
  ¬(0 = 1 ∈ Z2)
proof
  intro p
  elim 1
  elim 2
qed

-- Unfolding quotient equality recovers the equivalence relation.
theorem eq_to_rel :
  ∀x:Int. ∀y:Int. x = y ∈ Z2 → EqMod2(x; y)
proof
  intro x
  intro y
  intro p
  elim 3
  hyp
qed

--------------------------------------------------------------------------------
-- Functionality principle: well-definedness on quotients
--------------------------------------------------------------------------------

-- A function out of a quotient is well-defined precisely when it respects E.
theorem quot_functionality :
  ∀f:(Int → Int).
    (∀x:Int. ∀y:Int. EqMod2(x; y) → f x = f y ∈ Int) →
    ∀q:Z2. f q = f q ∈ Int
proof
  intro f
  intro resp
  intro q
  elim 3
  elim 2 with v THENL [
    hyp,
    elim 7 with w THENL [
      hyp,
      elim 8 with p THENL [hyp, hyp]
    ]
  ]
qed

-- Successor on representatives respects ≡ (mod 2).
theorem succ_0_2 :
  0 + 1 = 2 + 1 ∈ Z2
proof
  eq THEN auto
qed

-- `max` does NOT respect ≡ (mod 2): 0 = 2 in Z2, but
-- max(1,0) = 1 and max(1,2) = 2, and 1 ≠ 2 in Z2 (§2.4).
theorem max_not_wd :
  ¬(Max(1; 0) = Max(1; 2) ∈ Z2)
proof
  intro p
  elim 1
  elim 2
qed

--------------------------------------------------------------------------------
-- Indiscrete quotient
--------------------------------------------------------------------------------

-- Independent quotient `Int // True`: all integers become equal.
theorem unit_quot_type :
  (Int // True) ∈ U{i}
proof
  eq THENL [eq, eq, intro, intro, intro]
qed

theorem all_eq_in_true :
  0 = 1 ∈ (Int // True)
proof
  eq THEN auto
qed
