-- | Equality, membership, congruence, Leibniz substitution, and discrimination.
--
-- `t ∈ A` is the soft encoding `t = t ∈ A`. Equality is proof-irrelevant
-- (extracts are `Ax`). Elimination rewrites the conclusion; distinct
-- canonical constructors have empty equality.
-- This theory formalizes equivalence properties (refl, sym, trans),
-- Leibniz substitution, function application congruence, product/coproduct
-- congruence, constructor discrimination, and universe membership of equalities.
theory Equality

--------------------------------------------------------------------------------
-- Reflexivity and membership
--------------------------------------------------------------------------------

theorem refl_at :
  ∀A:U{i}. ∀x:A. x = x ∈ A
proof
  intro A
  intro x
  hyp
qed

theorem member_from_decl :
  ∀A:U{i}. ∀x:A. x ∈ A
proof
  intro A
  intro x
  hyp
qed

--------------------------------------------------------------------------------
-- Symmetry, transitivity, and Leibniz substitution
--------------------------------------------------------------------------------

theorem eq_sym :
  ∀A:U{i}. ∀x:A. ∀y:A. x = y ∈ A → y = x ∈ A
proof
  intro A
  intro x
  intro y
  intro p
  elim 4
  hyp
qed

theorem eq_trans :
  ∀A:U{i}. ∀x:A. ∀y:A. ∀z:A. x = y ∈ A → y = z ∈ A → x = z ∈ A
proof
  intro A
  intro x
  intro y
  intro z
  intro p
  intro q
  elim 5
  elim 6
  hyp
qed

-- Leibniz: equal elements are interchangeable in any type family.
theorem subst :
  ∀A:U{i}. ∀B:(A → U{i}). ∀x:A. ∀y:A. x = y ∈ A → B x → B y
proof
  intro A
  intro B
  intro x
  intro y
  intro p
  intro bx
  elim 5
  hyp
qed

--------------------------------------------------------------------------------
-- Congruence
--------------------------------------------------------------------------------

theorem eq_app :
  ∀A:U{i}. ∀B:U{i}. ∀f:(A → B). ∀x:A. ∀y:A.
    x = y ∈ A → f x = f y ∈ B
proof
  intro A
  intro B
  intro f
  intro x
  intro y
  intro p
  elim 6 THEN auto
qed

theorem eq_pair :
  ∀A:U{i}. ∀B:U{i}. ∀x1:A. ∀x2:A. ∀y1:B. ∀y2:B.
    x1 = x2 ∈ A → y1 = y2 ∈ B → <x1, y1> = <x2, y2> ∈ A × B
proof
  intro A
  intro B
  intro x1
  intro x2
  intro y1
  intro y2
  intro px
  intro py
  elim 7
  elim 8
  auto
qed

theorem eq_inl :
  ∀A:U{i}. ∀B:U{i}. ∀x1:A. ∀x2:A.
    x1 = x2 ∈ A → inl x1 = inl x2 ∈ A ⊎ B
proof
  intro A
  intro B
  intro x1
  intro x2
  intro px
  elim 5
  auto
qed

theorem eq_inr :
  ∀A:U{i}. ∀B:U{i}. ∀y1:B. ∀y2:B.
    y1 = y2 ∈ B → inr y1 = inr y2 ∈ A ⊎ B
proof
  intro A
  intro B
  intro y1
  intro y2
  intro py
  elim 5
  auto
qed

theorem unit_eta :
  ∀x:Unit. x = Ax ∈ Unit
proof
  intro x
  eq
qed

--------------------------------------------------------------------------------
-- Constructor discrimination
--------------------------------------------------------------------------------

theorem inl_inr_neq :
  ∀A:U{i}. ∀B:U{i}. ∀a:A. ∀b:B. ¬(inl a = inr b ∈ A ⊎ B)
proof
  intro A
  intro B
  intro a
  intro b
  intro p
  elim 5
qed

theorem zero_ne_one :
  ¬(0 = 1 ∈ Int)
proof
  intro p
  elim 1
qed

theorem token_neq :
  ¬("yes" = "no" ∈ Atom)
proof
  intro p
  elim 1
qed

--------------------------------------------------------------------------------
-- Universes
--------------------------------------------------------------------------------

theorem type_in_univ :
  ∀A:U{i}. A ∈ U{i}
proof
  intro A
  hyp
qed

theorem eq_in_univ :
  ∀A:U{i}. ∀x:A. ∀y:A. (x = y ∈ A) ∈ U{i}
proof
  intro A
  intro x
  intro y
  eq THEN auto
qed
