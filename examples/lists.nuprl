-- | Foundational list theory: formation, constructors, discrimination,
-- the structural recursor, and algebraic reduction laws.
--
-- This theory formalizes polymorphic list operations (Append, Length, Map,
-- IsEmpty), establishes their definitional reduction equations at nil and cons,
-- proves constructor discrimination (`nil_ne_cons`), and provides exemplary
-- evaluations for practical programming languages theory work.
theory Lists

abs Append(xs; ys) == list_ind xs (ys) (h, t, ih. h :: ih)
abs Length(xs) == list_ind xs 0 (h, t, ih. ih + 1)
abs Map(f; xs) == list_ind xs [] (h, t, ih. f h :: ih)
abs IsEmpty(xs) == list_ind xs True (h, t, ih. False)

soft Append, Length, Map, IsEmpty

--------------------------------------------------------------------------------
-- Formation and constructors
--------------------------------------------------------------------------------

theorem nil_poly :
  ∀A:U{i}. [] ∈ List A
proof
  intro A
  intro
qed

theorem cons_intro :
  ∀A:U{i}. A → List A → List A
proof
  intro A
  intro h
  intro t
  intro with h THENL [hyp, hyp]
qed

--------------------------------------------------------------------------------
-- Discrimination
--------------------------------------------------------------------------------

theorem nil_ne_cons :
  ∀A:U{i}. ∀h:A. ∀t:List A. ¬([] = h :: t ∈ List A)
proof
  intro A
  intro h
  intro t
  intro p
  elim 4
qed

--------------------------------------------------------------------------------
-- Structural recursion
--------------------------------------------------------------------------------

-- The list recursor. Extract is `list_ind`.
theorem list_rec :
  ∀A:U{i}. ∀C:U{i}. C → (A → List A → C → C) → List A → C
proof
  intro A
  intro C
  intro base
  intro step
  intro xs
  elim 5 THENL [
    hyp 3,
    elim 4 with h THENL [
      hyp,
      elim 9 with tl THENL [hyp, elim 10 with ih THENL [hyp, hyp]]
    ]
  ]
qed

--------------------------------------------------------------------------------
-- Algebraic laws: Append
--------------------------------------------------------------------------------

theorem append_nil_l :
  ∀A:U{i}. ∀ys:List A. Append([] ; ys) = ys ∈ List A
proof
  intro A
  intro ys
  auto
qed

theorem append_cons_l :
  ∀A:U{i}. ∀x:A. ∀xs:List A. ∀ys:List A.
    Append(x :: xs; ys) = x :: Append(xs; ys) ∈ List A
proof
  intro A
  intro x
  intro xs
  intro ys
  auto
qed

--------------------------------------------------------------------------------
-- Algebraic laws: Map
--------------------------------------------------------------------------------

theorem map_nil :
  ∀A:U{i}. ∀B:U{i}. ∀f:(A → B). Map(f; []) = [] ∈ List B
proof
  intro A
  intro B
  intro f
  auto
qed

theorem map_cons :
  ∀A:U{i}. ∀B:U{i}. ∀f:(A → B). ∀x:A. ∀xs:List A.
    Map(f; x :: xs) = f x :: Map(f; xs) ∈ List B
proof
  intro A
  intro B
  intro f
  intro x
  intro xs
  auto
qed

--------------------------------------------------------------------------------
-- Algebraic laws: Length
--------------------------------------------------------------------------------

theorem length_nil :
  Length([]) = 0 ∈ Int
proof
  auto
qed

theorem length_cons :
  ∀A:U{i}. ∀x:A. ∀xs:List A.
    Length(x :: xs) = Length(xs) + 1 ∈ Int
proof
  intro A
  intro x
  intro xs
  auto
qed

--------------------------------------------------------------------------------
-- Predicates: IsEmpty
--------------------------------------------------------------------------------

theorem is_empty_nil :
  IsEmpty([]) = True ∈ U{i}
proof
  auto
qed

theorem is_empty_cons :
  ∀A:U{i}. ∀x:A. ∀xs:List A.
    IsEmpty(x :: xs) = False ∈ U{i}
proof
  intro A
  intro x
  intro xs
  auto
qed

--------------------------------------------------------------------------------
-- Exemplary evaluations
--------------------------------------------------------------------------------

theorem append_example :
  Append([1, 2] ; [3, 4]) = [1, 2, 3, 4] ∈ List Int
proof
  auto
qed

theorem map_example :
  Map((λx. x + 10); [1, 2]) = [11, 12] ∈ List Int
proof
  auto
qed
